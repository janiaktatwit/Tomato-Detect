import cv2
from ultralytics import YOLO
import torch

# Optional: Detectron2 imports if you want segmentation refinement
# from detectron2.engine import DefaultPredictor
# from detectron2.config import get_cfg
# from detectron2 import model_zoo

# --- Step 1: Initialize YOLOv8 model ---
# Load pretrained YOLOv8 model (or your custom-trained tomato/pepper model)
model = YOLO("yolov8n.pt")  # Replace with your trained weights path

# --- Step 2: Initialize camera feed ---
cap = cv2.VideoCapture(0)  # 0 = default webcam

# --- Step 3: (Optional) Setup Detectron2 for segmentation refinement ---
# cfg = get_cfg()
# cfg.merge_from_file(model_zoo.get_config_file("COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x.yaml"))
# cfg.MODEL.ROI_HEADS.SCORE_THRESH_TEST = 0.5
# cfg.MODEL.WEIGHTS = model_zoo.get_checkpoint_url("COCO-InstanceSegmentation/mask_rcnn_R_50_FPN_3x.yaml")
# predictor = DefaultPredictor(cfg)

# --- Step 4: Process frames ---
while True:
    ret, frame = cap.read()
    if not ret:
        break

    # Run YOLOv8 detection
    results = model(frame)

    # Draw bounding boxes
    for box in results[0].boxes:
        x1, y1, x2, y2 = box.xyxy[0]
        label = model.names[int(box.cls)]
        conf = box.conf[0]

        # Draw rectangle and label
        cv2.rectangle(frame, (int(x1), int(y1)), (int(x2), int(y2)), (0,255,0), 2)
        cv2.putText(frame, f"{label} {conf:.2f}", (int(x1), int(y1)-10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,255,255), 2)

        # Print coordinates for screen mapping
        print(f"{label} detected at: ({int(x1)}, {int(y1)}) to ({int(x2)}, {int(y2)})")

    # Optional: Detectron2 segmentation refinement
    # outputs = predictor(frame)
    # masks = outputs["instances"].pred_masks
    # You could overlay masks here for pixel-level precision

    # Display frame
    cv2.imshow("Tomato/Pepper Detection", frame)

    # Quit with 'q'
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
